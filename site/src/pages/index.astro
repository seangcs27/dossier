---
import Shell from '../layouts/Shell.astro';
---
<Shell
  view="grid"
  title="Arknights operators — Dossier"
  description="Every Arknights operator, Global and CN, by class, branch, rarity, collab and tag, each with a dossier."
/>

<script>
  import { mountGrid } from '@web/views/grid';
  import { onPage } from '../lib/page';
  import { portedPath } from '../lib/ported';

  // An old address ('/dossier/#/op/…', a bookmark from the SPA) is the root's, and goes on to
  // its page; an address no page has is the grid, as in the SPA.
  onPage('grid', (view) => {
    const page = portedPath(window.location.hash);
    if (page) window.location.replace(page);
    else mountGrid(view);
  });
  // One typed into the address bar changes the hash and nothing else.
  window.addEventListener('hashchange', () => {
    const page = portedPath(window.location.hash);
    if (page) window.location.replace(page);
  });
</script>
