<Shell view="holodori-home" title="hololive Dreams — Dossier" />

<script>
  // The SPA's own front page, mounted into the shell as it is. Rendering it at build time is
  // Phases 2 and 3 of the plan; this page proves the shell, the styles and the route.
  import { initShell, showShell } from '../../../../src/web/shell';
  import { mountHolodoriHome } from '../../../../src/web/views/holodori-home';

  initShell();
  showShell('holodori-home');
  mountHolodoriHome(document.getElementById('view')!);
</script>
