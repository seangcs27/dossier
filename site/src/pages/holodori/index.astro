---
import Shell from '../../layouts/Shell.astro';
import { homeHtml } from '@web/render/holodori-home-html';
import { buildNow } from '../../lib/now';
---
<Shell
  view="holodori-home"
  title="hololive Dreams — Dossier"
  description="hololive Dreams: its holomems, songs, cards and gachas, the gachas running now and the birthdays coming."
>
  <Fragment set:html={homeHtml(buildNow(), { backs: true })} />
</Shell>

<script>
  import { backsInPage, wireTurns } from '@web/holodori-flip';
  import { freshen } from '@web/fresh';
  import { hideSearch, initShell, showShell } from '@web/shell';
  import '@web/holodori-clip';

  initShell();
  showShell('holodori-home');
  hideSearch();
  freshen();
  const page = document.querySelector<HTMLElement>('.hh-page')!;
  wireTurns(page, backsInPage(page));
</script>
