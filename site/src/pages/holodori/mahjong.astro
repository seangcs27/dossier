---
import Shell from '../../layouts/Shell.astro';
import { holojongPageHtml } from '@web/render/holojong-html';
---
<Shell
  view="holodori-mahjong"
  title="Holojang guide — hololive — Dossier"
  description="How to get hololive Mahjong -Holojang-, how to play Japanese riichi mahjong, and what the Japanese on its screens means."
>
  <Fragment set:html={holojongPageHtml()} />
</Shell>

<script>
  import { hideSearch } from '@web/shell';
  import { wireGuideDemo, wireGuideDock, wireGuideLang, wireGuideLinks } from '@web/views/holodori-mahjong';
  import { onPage } from '../../lib/page';

  onPage('holodori-mahjong', (view) => {
    hideSearch();
    wireGuideLinks(view);
    wireGuideLang(view);
    wireGuideDemo(view);
    wireGuideDock(view);
  });
</script>
