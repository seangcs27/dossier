---
// The SPA's own index.html (sidebar, topbar, the goo filters), split where a page goes. It is
// read, not copied, so the two targets cannot drift while both exist; Phase 8 moves the markup
// in here and deletes index.html.
import { readFileSync } from 'node:fs';
import { ClientRouter } from 'astro:transitions';
import '../../../src/web/styles.scss';
import ported from '../ported-routes.json';
import { portedLinks } from '../lib/ported';

interface Props {
  view: string;
  title?: string;
  description?: string;
  // Becomes data-* attributes on #view, for the page's script (an id, a tab).
  data?: Record<string, string | undefined>;
}
const { view, title = 'Dossier', description, data = {} } = Astro.props;
const dataAttrs = Object.fromEntries(Object.entries(data).map(([key, value]) => [`data-${key}`, value]));

// Astro bundles this file, so import.meta.url would point into the build's output: the
// build is run from site/, and the SPA's page is one folder up.
const source = readFileSync('../src/web/index.html', 'utf8');
const between = (open: string, close: string): string =>
  source.slice(source.indexOf(open) + open.length, source.indexOf(close));

const head = between('<head>', '</head>')
  .replace(/<title>.*<\/title>\s*/, '')
  .replace(/<link rel="stylesheet" href="styles.css">\s*/, '');

// A route Astro already serves links to its page; the others still live in the SPA, which is
// where <base> below sends a '#/…' link.
let [top, bottom] = between('<body>', '<script src="app.js"></script>').split('<main id="view"></main>');
for (const [hash, page] of Object.entries(ported)) top = top.replaceAll(`href="${hash}"`, `href="${page}"`);

// The client router swaps the page under the sidebar and the topbar and keeps them, as the
// SPA does: their handlers, the section links' moving fill and the search box are the shell's.
const keep = (html: string, open: string, id: string): string => html.replace(open, `${open} data-astro-transition-persist="${id}"`);
top = keep(keep(keep(top, '<nav class="sidebar"', 'sidebar'), '<div class="side-scrim"', 'side-scrim'), '<div class="topbar"', 'topbar');
bottom = keep(bottom, '<svg class="svg-defs"', 'svg-defs');

// Every address in the SPA's markup and code is written beside index.html ('icons/…',
// 'holodori/jackets/…'). Under /holodori/ that would be one folder too deep, so the pages
// resolve them from the site's root, as the SPA does.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The page drawn at build time links its own way ('#/holodori/songs', from the renderers the
// SPA shares): written as the pages' paths here, so that prefetch and a new tab find the page.
// A page its view fills in the browser has nothing here.
const page = Astro.slots.has('default') ? portedLinks(await Astro.slots.render('default')) : '';
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <base href={base} />
    <Fragment set:html={head} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url} />
    <ClientRouter />
  </head>
  <body data-view={view}>
    <Fragment set:html={top} />
    <main id="view" {...dataAttrs}><Fragment set:html={page} /></main>
    <Fragment set:html={bottom} />
  </body>
</html>
