{
  "name": "dossier",
  "version": "0.1.0",
  "description": "Arknights operator lookup — browser extension + web SPA",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "build": "npm run build:ext && npm run build:web",
    "build:index": "npm run build:index:operators && npm run build:index:ranges && npm run build:index:events && npm run build:index:endfield && npm run build:index:ptn && npm run build:index:holodori && npm run build:index:fgo",
    "build:index:operators": "node --no-network-family-autoselection scripts/build-operator-index.mjs",
    "build:index:ranges": "node --no-network-family-autoselection scripts/build-range-index.mjs",
    "build:index:events": "node --no-network-family-autoselection scripts/build-event-index.mjs",
    "build:index:endfield": "node --no-network-family-autoselection scripts/build-endfield-index.mjs",
    "build:index:ptn": "node --no-network-family-autoselection scripts/build-ptn-index.mjs",
    "build:index:holodori": "node --no-network-family-autoselection scripts/build-holodori-index.mjs",
    "build:index:fgo": "node --no-network-family-autoselection scripts/build-fgo-index.mjs",
    "design": "npm run build:web && node scripts/build-design-previews.mjs",
    "prebuild:site": "npm run build:index",
    "build:site": "npm run build -w site",
    "predev:site": "npm run build:index",
    "dev:site": "npm run dev -w site",
    "routes": "node scripts/route-inventory.mjs",
    "shots": "node scripts/shots.mjs",
    "render-check": "node scripts/render-check.mjs",
    "prebuild:ext": "npm run build:index",
    "build:ext": "webpack --config webpack.ext.js --mode production",
    "prebuild:web": "npm run build:index",
    "build:web": "webpack --config webpack.web.js --mode production",
    "predev": "npm run build:index",
    "dev": "webpack --config webpack.ext.js --mode development --watch",
    "predev:web": "npm run build:index",
    "dev:web": "webpack --config webpack.web.js --mode development --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.10.7",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "pixelmatch": "^8.0.0",
    "puppeteer-core": "^25.16.0",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
